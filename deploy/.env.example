# Adresse d'ecoute. Utiliser l'IP Tailscale du serveur pour ne pas exposer la
# console sans mot de passe sur le LAN ou Internet.
LBC_BIND_IP=127.0.0.1
LBC_PORT=8899

# Donnees persistantes hors de la VM Docker Desktop.
LBC_DATA_DIR=../data

LBC_MODE=live

# Gateway OpenAI-compatible : sans elle, la cle LLM seule ne suffit pas.
LLM_BASE_URL=
LLM_MODEL=gemini-3.7-flash-high
