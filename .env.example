# Configuration non-secrète uniquement.
# Les clés API (AnySolver, LLM, webhook Discord), la session Leboncoin et le proxy
# sont stockés chiffrés via DPAPI (CurrentUser) dans SQLite — jamais dans ce fichier.

# Serveur
HOST=127.0.0.1
PORT=8787

# Mode transport Leboncoin : "fixtures" (hors-ligne) ou "live" (phase 5+, nécessite wreq-js)
LBC_MODE=fixtures

# Répertoire de données (SQLite, logs)
DATA_DIR=./data

# Origine du frontend en dev (CORS)
WEB_ORIGIN=http://localhost:5173

# LLM (Anthropic-compatible). HTTP public = risque accepté, bandeau permanent dans l'UI.
# La clé API va dans le coffre DPAPI via l'écran Système, pas ici.
LLM_BASE_URL=
LLM_MODEL=gemini-3.7-flash-high
