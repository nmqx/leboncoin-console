{
  "name": "lbc-console",
  "version": "0.1.0",
  "private": true,
  "description": "Console locale Leboncoin — recherche, veilles, messagerie, webhooks",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n srv,web -c blue,magenta \"npm:dev -w apps/server\" \"npm:dev -w apps/web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "start": "npm run start -w apps/server",
    "build": "npm run build -w apps/web && npm run typecheck -w apps/server",
    "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx apps/server/src/mcp/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
